        { "rank": 2, "name": "Big Pickle", "native_id": "opencode/big-pickle", "resolved": true },
        { "rank": 3, "name": "Nemotron 3.5 Lightning Free", "native_id": "opencode/nemotron-3.5-lightning-free", "resolved": true },
